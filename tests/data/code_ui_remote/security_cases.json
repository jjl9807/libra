{
  "schemaVersion": 1,
  "matrix": "code_ui_remote_security",
  "defaults": {
    "fixture": {
      "path": "tests/fixtures/code_ui/basic_chat.json"
    },
    "options": {
      "control": "write",
      "browserControl": "off"
    }
  },
  "cases": [
    {
      "name": "security_diagnostics_does_not_expose_control_or_controller_token",
      "priority": "P1",
      "steps": [
        {
          "name": "attach automation",
          "op": "attach",
          "kind": "automation",
          "clientId": "security-diagnostics-token",
          "auth": "valid_control",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        },
        {
          "name": "get diagnostics raw text",
          "op": "diagnosticsRaw",
          "expect": {
            "assertions": [
              "does_not_contain_control_token",
              "does_not_contain_controller_token",
              "does_not_contain:X-Libra-Control-Token",
              "does_not_contain:X-Code-Controller-Token"
            ]
          }
        }
      ]
    },
    {
      "name": "security_diagnostics_redacts_secret_like_log_file_path",
      "priority": "P1",
      "options": {
        "extraEnv": {
          "LIBRA_LOG_FILE": "target/code-ui-scenarios/security-secret-token-12345/libra.log"
        }
      },
      "steps": [
        {
          "name": "get diagnostics raw text",
          "op": "diagnosticsRaw",
          "expect": {
            "assertions": [
              "does_not_contain:secret-token-12345"
            ]
          }
        }
      ]
    },
    {
      "name": "security_attach_with_control_observe_is_403_control_disabled",
      "priority": "P1",
      "options": {
        "control": "observe"
      },
      "steps": [
        {
          "name": "attach automation without write control enabled",
          "op": "attach",
          "kind": "automation",
          "clientId": "security-control-observe",
          "auth": "missing_control",
          "expect": {
            "status": 403,
            "errorCode": "CONTROL_DISABLED"
          }
        }
      ]
    },
    {
      "name": "security_threads_invalid_limit_returns_invalid_query_param",
      "priority": "P1",
      "steps": [
        {
          "name": "get threads invalid limit",
          "op": "getThreads",
          "limit": "abc",
          "offset": null,
          "expect": {
            "status": 400,
            "errorCode": "INVALID_QUERY_PARAM",
            "assertions": [
              "error_message_contains:limit"
            ]
          }
        }
      ]
    },
    {
      "name": "security_threads_limit_clamped_to_200_max",
      "priority": "P1",
      "steps": [
        {
          "name": "get threads huge limit",
          "op": "getThreads",
          "limit": "99999",
          "offset": "0",
          "expect": {
            "status": 200,
            "assertions": [
              "items_len_lte:200"
            ]
          }
        }
      ]
    },
    {
      "name": "security_audit_log_records_attach_with_redacted_client_id",
      "priority": "P1",
      "steps": [
        {
          "name": "attach with secret-like client id",
          "op": "attach",
          "kind": "automation",
          "clientId": "local-script token:super-secret-999",
          "auth": "valid_control",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        },
        {
          "name": "read libra log",
          "op": "libraLogRaw",
          "expect": {
            "assertions": [
              "contains:controller.attach",
              "does_not_contain:super-secret-999"
            ]
          }
        }
      ]
    },
    {
      "name": "security_non_loopback_session_route_is_inline_unit",
      "priority": "P1",
      "testKind": "inline",
      "target": "src/internal/ai/web/mod.rs",
      "steps": [
        {
          "name": "GET /api/code/session from non-loopback",
          "op": "oneshotRoute",
          "method": "GET",
          "path": "/api/code/session",
          "remoteAddr": "192.0.2.10:4000",
          "expect": {
            "status": 403,
            "errorCode": "LOOPBACK_REQUIRED"
          }
        }
      ]
    },
    {
      "name": "security_non_loopback_messages_route_rejects_before_controller_token",
      "priority": "P1",
      "testKind": "inline",
      "target": "src/internal/ai/web/mod.rs",
      "steps": [
        {
          "name": "POST /api/code/messages from non-loopback",
          "op": "oneshotRoute",
          "method": "POST",
          "path": "/api/code/messages",
          "remoteAddr": "192.0.2.10:4000",
          "body": {
            "text": "/chat hello"
          },
          "expect": {
            "status": 403,
            "errorCode": "LOOPBACK_REQUIRED"
          }
        }
      ]
    },
    {
      "name": "security_browser_write_missing_origin_is_403_origin_required",
      "priority": "P1",
      "tags": ["origin"],
      "options": {
        "browserControl": "loopback"
      },
      "steps": [
        {
          "name": "browser attach without Origin",
          "op": "browserAttachWithoutOrigin",
          "clientId": "security-origin-missing",
          "expect": {
            "status": 403,
            "errorCode": "ORIGIN_REQUIRED"
          }
        }
      ]
    },
    {
      "name": "security_browser_write_cross_site_origin_is_403_origin_required",
      "priority": "P1",
      "tags": ["origin"],
      "options": {
        "browserControl": "loopback"
      },
      "steps": [
        {
          "name": "browser attach with cross-site Origin",
          "op": "browserAttachWithOrigin",
          "clientId": "security-origin-cross",
          "origin": "https://evil.example",
          "expect": {
            "status": 403,
            "errorCode": "ORIGIN_REQUIRED"
          }
        }
      ]
    },
    {
      "name": "security_browser_write_trusted_loopback_origin_succeeds",
      "priority": "P1",
      "tags": ["origin"],
      "options": {
        "browserControl": "loopback"
      },
      "steps": [
        {
          "name": "browser attach with trusted Origin",
          "op": "attach",
          "kind": "browser",
          "clientId": "security-origin-ok",
          "auth": "none",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        }
      ]
    },
    {
      "name": "security_browser_message_missing_origin_is_403_origin_required",
      "priority": "P1",
      "tags": ["origin"],
      "testKind": "inline",
      "target": "tests/code_ui_remote_security_matrix.rs",
      "options": {
        "browserControl": "loopback"
      },
      "steps": [
        {
          "name": "browser attach then /messages without Origin",
          "op": "oneshotRoute",
          "method": "POST",
          "path": "/api/code/messages",
          "expect": {
            "status": 403,
            "errorCode": "ORIGIN_REQUIRED"
          }
        }
      ]
    },
    {
      "name": "security_browser_message_cross_site_origin_is_403_origin_required",
      "priority": "P1",
      "tags": ["origin"],
      "testKind": "inline",
      "target": "tests/code_ui_remote_security_matrix.rs",
      "options": {
        "browserControl": "loopback"
      },
      "steps": [
        {
          "name": "browser attach then /messages with cross-site Origin",
          "op": "oneshotRoute",
          "method": "POST",
          "path": "/api/code/messages",
          "expect": {
            "status": 403,
            "errorCode": "ORIGIN_REQUIRED"
          }
        }
      ]
    },
    {
      "name": "security_automation_write_without_origin_succeeds",
      "priority": "P1",
      "tags": ["origin"],
      "steps": [
        {
          "name": "automation attach without Origin",
          "op": "attach",
          "kind": "automation",
          "clientId": "security-automation-no-origin",
          "auth": "valid_control",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        }
      ]
    },
    {
      "name": "security_session_rate_limit_triggers_and_recovers",
      "priority": "P1",
      "tags": ["rate_limit"],
      "options": {
        "extraEnv": {
          "LIBRA_CODE_SESSION_WRITE_RATE_LIMIT": "2",
          "LIBRA_CODE_SESSION_WRITE_RATE_WINDOW_SECS": "2"
        }
      },
      "steps": [
        {
          "name": "attach automation",
          "op": "attach",
          "kind": "automation",
          "clientId": "security-rate-limit",
          "auth": "valid_control",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        },
        {
          "name": "second write within budget",
          "op": "submit",
          "text": "/chat rate-1",
          "token": "current",
          "auth": "valid_control",
          "expect": {
            "status": 200
          }
        },
        {
          "name": "third write trips rate limit",
          "op": "submit",
          "text": "/chat rate-2",
          "token": "current",
          "auth": "valid_control",
          "expect": {
            "status": 429,
            "errorCode": "RATE_LIMITED"
          }
        },
        {
          "name": "wait for window recovery",
          "op": "sleep",
          "durationMs": 2100
        },
        {
          "name": "write succeeds after window",
          "op": "submit",
          "text": "/chat rate-3",
          "token": "current",
          "auth": "valid_control",
          "expect": {
            "status": 200
          }
        }
      ]
    },
    {
      "name": "security_browser_write_body_size_too_large_is_413_payload_too_large",
      "priority": "P1",
      "tags": ["body_size"],
      "options": {
        "browserControl": "loopback"
      },
      "steps": [
        {
          "name": "browser attach",
          "op": "attach",
          "kind": "browser",
          "clientId": "security-body-browser",
          "auth": "none",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        },
        {
          "name": "oversized browser submit",
          "op": "browserSubmitLarge",
          "bytes": 262145,
          "token": "current",
          "expect": {
            "status": 413,
            "errorCode": "PAYLOAD_TOO_LARGE"
          }
        }
      ]
    },
    {
      "name": "security_automation_write_body_size_too_large_is_413_payload_too_large",
      "priority": "P1",
      "tags": ["body_size"],
      "steps": [
        {
          "name": "attach automation",
          "op": "attach",
          "kind": "automation",
          "clientId": "security-body-automation",
          "auth": "valid_control",
          "expect": {
            "status": 200,
            "saveToken": "current"
          }
        },
        {
          "name": "oversized automation submit",
          "op": "submitLarge",
          "bytes": 262145,
          "token": "current",
          "auth": "valid_control",
          "expect": {
            "status": 413,
            "errorCode": "PAYLOAD_TOO_LARGE"
          }
        }
      ]
    }
  ]
}
